rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // server-only, via Admin SDK

      match /runs/{runId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false; // server-only
      }
    }
  }
}
